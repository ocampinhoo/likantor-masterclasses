# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=
APP_TIMEZONE=America/Mexico_City

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=likantor_masterclasses
DB_USER=
DB_PASSWORD=

# Session
SESSION_LIFETIME=7200

# SendGrid (usado por el sistema de leads / temario)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Likantor Masterclasses
SENDGRID_REPLY_TO=

# Stripe
# Deja STRIPE_SECRET_KEY vacío en local para activar el simulador de pagos (sin
# credenciales reales). STRIPE_WEBHOOK_SECRET SÍ debe tener un valor (puede ser
# cualquier cadena inventada en desarrollo) para poder firmar/validar webhooks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago
# Deja MERCADOPAGO_ACCESS_TOKEN vacío en local para activar el simulador de pagos.
# MERCADOPAGO_WEBHOOK_SECRET SÍ debe tener un valor propio (no requiere ser real)
# para poder firmar/validar webhooks localmente.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: solo si tu cuenta de Mercado Pago no puede liquidar en la moneda
# comercial de la Masterclass (ver config/payments.php).
MERCADOPAGO_CHECKOUT_CURRENCY=
MERCADOPAGO_CHECKOUT_AMOUNT=

# Zoom (Fase posterior)
ZOOM_API_KEY=
ZOOM_API_SECRET=

# Admin notifications
ADMIN_NOTIFICATION_EMAIL=

# Security
RATE_LIMIT_ENABLED=true
